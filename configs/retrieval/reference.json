{
  "schema_version": "1.0",
  "document_path": "output/parsing/document.json",
  "golden_dataset_path": "output/datasets/golden/golden_dataset.jsonl",
  "output_directory": "output/retrieval/reference",
  "chunking": {
    "strategy": "token_window",
    "chunk_size": 500,
    "chunk_overlap": 50
  },
  "tokenizer": {
    "name": "testrx_regex_tokenizer",
    "version": "1.0"
  },
  "embedding": {
    "model": "stable_hashing_word_bigram",
    "model_version": "1.0",
    "dimension": 4096
  },
  "retrieval": {
    "algorithm": "cosine_similarity_exact",
    "top_k": [1, 3, 5, 10]
  }
}
