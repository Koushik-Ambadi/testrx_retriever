{
  "schema_version": "1.0",
  "inputs": {
    "document_path": "output/parsing/document.json",
    "golden_dataset_path": "output/datasets/golden/golden_dataset.jsonl"
  },
  "output_directory": "output/retrieval/pipeline_candidates",
  "chunking": {
    "strategy": "token_window",
    "chunk_size": 300,
    "chunk_overlap": 30
  },
  "retrieval": {"candidate_k": 20},
  "bi_encoders": [
    {
      "id": "lexical_hashing",
      "algorithm": "stable_hashing_word_bigram",
      "dimension": 8192
    },
    {
      "id": "dense_bge_small_en_v15",
      "algorithm": "sentence_transformer",
      "model_path": "model_store/encoders/artifacts/dense_bge_small_en_v15",
      "revision": "5c38ec7c405ec4b44b94cc5a9bb96e735b38267a",
      "batch_size": 32
    },
    {
      "id": "dense_e5_small_v2",
      "algorithm": "sentence_transformer",
      "model_path": "model_store/encoders/artifacts/dense_e5_small_v2",
      "revision": "ffb93f3bd4047442299a41ebb6fa998a38507c52",
      "query_prefix": "query: ",
      "document_prefix": "passage: ",
      "batch_size": 32
    }
  ],
  "fusions": [
    {
      "id": "hybrid_lexical_bge_rrf",
      "encoder_ids": ["lexical_hashing", "dense_bge_small_en_v15"],
      "rank_constant": 60
    },
    {
      "id": "hybrid_lexical_e5_rrf",
      "encoder_ids": ["lexical_hashing", "dense_e5_small_v2"],
      "rank_constant": 60
    }
  ],
  "rerankers": [
    {
      "id": "reranker_minilm_l6",
      "algorithm": "sentence_transformer_cross_encoder",
      "model_path": "model_store/rerankers/artifacts/reranker_minilm_l6",
      "revision": "233902d25c440f23af6f7d6e94d2946bac0bee0a",
      "batch_size": 32
    }
  ],
  "evaluation": {"top_k": [1, 3, 5, 10]}
}
