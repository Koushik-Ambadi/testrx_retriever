{
  "schema_version": "1.0",
  "inputs": {
    "document_path": "output/parsing/document.json",
    "golden_dataset_path": "output/datasets/golden/golden_dataset.jsonl"
  },
  "output_directory": "output/retrieval/pipeline_baseline",
  "chunking": {
    "strategy": "token_window",
    "chunk_size": 300,
    "chunk_overlap": 30
  },
  "retrieval": {
    "candidate_k": 20
  },
  "bi_encoders": [
    {
      "id": "lexical_hashing",
      "algorithm": "stable_hashing_word_bigram",
      "dimension": 8192
    },
    {
      "id": "semantic_lsa",
      "algorithm": "latent_semantic_lsa",
      "hash_dimension": 4096,
      "latent_dimension": 128
    }
  ],
  "fusion": {
    "enabled": true,
    "id": "hybrid_rrf",
    "encoder_ids": ["lexical_hashing", "semantic_lsa"],
    "rank_constant": 60
  },
  "reranker": {
    "id": "pairwise_lexical",
    "algorithm": "lexical_pairwise_baseline"
  },
  "evaluation": {
    "top_k": [1, 3, 5, 10]
  }
}
