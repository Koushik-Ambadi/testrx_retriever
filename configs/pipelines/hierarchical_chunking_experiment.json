    },
    {
      "id": "hierarchical_max_512",
      "chunking": {"strategy": "hierarchical_max_tokens", "max_tokens": 512}
    },
    {
      "id": "hierarchical_max_640",
      "chunking": {"strategy": "hierarchical_max_tokens", "max_tokens": 640}
    },
    {
      "id": "hierarchical_max_768",
