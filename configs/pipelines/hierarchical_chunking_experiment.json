{
  "schema_version": "1.0",
  "experiment_id": "hierarchical-chunking-v1",
  "base_pipeline_config": "configs/pipelines/candidates.json",
  "output_directory": "output/retrieval/pipeline_hierarchy_chunking",
  "latency": {
    "enabled": true,
