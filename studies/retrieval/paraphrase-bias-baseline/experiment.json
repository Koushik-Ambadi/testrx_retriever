{
  "schema_version": "2.0",
  "experiment_id": "paraphrase-bias-baseline-v1",
  "title": "Controlled paraphrase lexical-bias baseline",
  "hypothesis": "The basic hashing model's strong score is substantially explained by lexical overlap with the source and will decline as controlled paraphrases become more conceptual.",
  "inputs": {
    "document_path": "output/parsing/document.json",
    "golden_dataset_path": "output/datasets/golden/golden_dataset.jsonl"
  },
  "output_store": "output/retrieval/experiment_store",
  "retention": {
    "run_metrics": true,
    "question_metrics": true,
    "chunks": false,
    "embeddings": false,
    "ranked_results": false
  },
  "evaluation": {
    "top_k": [1, 3, 5, 10],
    "random_baseline": {"seed": 20260912, "trials": 1000},
    "question_filter": {
      "paraphrase_levels": ["original", "level_1_light", "level_2_moderate", "level_3_strong", "level_4_conceptual"]
    }
  },
  "components": {
    "chunkers": [{
      "strategy": "token_window",
      "parameters": {
        "chunk_sizes": [500],
        "overlap": {"mode": "ratio", "value": 0.1, "rounding": "half_up"}
      }
    }],
    "embedders": [{
      "family": "lexical",
      "model": "stable_hashing_word_bigram",
      "model_version": "1.0",
      "parameters": {"dimensions": [4096]}
    }],
    "retrievers": [{"algorithm": "cosine_similarity_exact", "parameters": {}}],
    "rerankers": [{"algorithm": "none", "parameters": {}}]
  },
  "controls": []
}
